# Copier en .env et adapter
KAPSI_CABINET=BIMCOT
# Jeton exigé par l'application (vide = pas de jeton ; réseau local de confiance uniquement)
KAPSI_TOKEN=
# Moteur IA par défaut (modifiable dans Réglages) : none | ollama | groq | openrouter | deepseek | custom | kapsi
KAPSI_BACKEND=none
KAPSI_LLM_URL=
KAPSI_LLM_MODEL=
KAPSI_LLM_KEY=
# Pour KAPSI_BACKEND=kapsi : module Python exposant generate(prompt) -> str
KAPSI_MODEL_MODULE=
