# Copier en .env et adapter
KAPSI_CABINET=BIMCOT
# Jeton exigé par l'application (laisser vide = pas de jeton, réseau local de confiance uniquement)
KAPSI_TOKEN=
# Moteur IA : none (générateurs seuls, 100 % hors ligne) | ollama | kapsi
KAPSI_BACKEND=none
KAPSI_LLM_URL=http://ollama:11434
KAPSI_LLM_MODEL=qwen2.5:7b
# Pour KAPSI_BACKEND=kapsi : module Python exposant generate(prompt) -> str
KAPSI_MODEL_MODULE=
