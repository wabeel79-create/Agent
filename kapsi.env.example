# Configuration Kapsi-Q — copier ce fichier en "kapsi.env" et adapter.
# Nom du cabinet affiché dans l'en-tête des documents Word
KAPSI_CABINET=BIMCOT
# Jeton d'accès (laisser vide sur un réseau local de confiance ; sinon un mot de passe long)
KAPSI_TOKEN=
# Port de l'application
KAPSI_PORT=8000
# Moteur d'IA par défaut (modifiable ensuite dans Réglages) : none | ollama | groq | openrouter | deepseek | custom | kapsi
KAPSI_BACKEND=none
KAPSI_LLM_URL=
KAPSI_LLM_MODEL=
KAPSI_LLM_KEY=
